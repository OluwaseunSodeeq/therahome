generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  Pending
  Confirmed
  Processing
  Shipped
  Delivered
  Cancelled
}

model Booking {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  service   String
  location  String
  address   String
  date      String
  time      String
  note      String
  createdAt DateTime @default(now())

  @@map("bookings")
}
model BookingPlan {
  id        String   @id @default(cuid())
  name      String
  phone     String
  plan      String
  location  String
  address   String
  note      String
  createdAt DateTime @default(now())

  @@map("bookingPlans")
}

model Order {
  id        String   @id @default(cuid())
  customer  String
  phone     String
  email     String?
  address   String
  note      String?
  total     Float
  status    OrderStatus @default(Pending)
  createdAt DateTime @default(now())
  items      OrderItem[]
  @@index([createdAt])

}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  name      String
  price     Float
  quantity  Int
  image      String?
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

}
